# Reserved for the future live-model integration. Leave blank for the local stub.
ANTHROPIC_API_KEY=

# Supabase project URL and publishable anonymous key for browser/server clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reserved for a later admin flow; not used by the running app (seed scripts only).
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo mode (this fork) ---
# "true" enables the prefilled sign-in page and the one-click
# "Sign in as Admin / Staff / Member" buttons. Leave unset for a normal build.
NEXT_PUBLIC_DEMO_MODE=

# Optional per-role account overrides. If unset, lib/demo/accounts.ts falls back
# to the seeded demo accounts (password "Welcome!").
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=
DEMO_CLIENT_EMAIL=
DEMO_CLIENT_PASSWORD=
# The "Dev" all-access login. If unset it runs on the admin account above
# (DEMO_DEV_EMAIL defaults to DEMO_ADMIN_EMAIL) with the dev bypass layered on.
DEMO_DEV_EMAIL=
DEMO_DEV_PASSWORD=
# Shared fallback password for any role whose DEMO_<ROLE>_PASSWORD is unset.
DEMO_PASSWORD=
